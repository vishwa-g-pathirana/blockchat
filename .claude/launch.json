{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blockchat",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "mockup",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "--directory", "mockup"],
      "port": 4173
    },
    {
      "name": "light",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "light-client", "run", "dev"],
      "port": 5175
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "client", "run", "dev"],
      "port": 5173
    }
  ]
}
